generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clinic {
  id           String        @id @default(cuid())
  name         String
  bookingMode  String        @default("time")
  createdAt    DateTime      @default(now())
  slotRules    SlotRule[]
  reservations Reservation[]
  slotRuleTemplates SlotRuleTemplate[]
  rooms        Room[]
}

model SlotRule {
  id              String   @id @default(cuid())
  clinicId        String
  clinic          Clinic   @relation(fields: [clinicId], references: [id])
  weekday         Int
  startTime       String
  endTime         String
  intervalMinutes Int
  capacity        Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SlotRuleTemplate {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  name      String
  rules     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reservation {
  id          String            @id @default(cuid())
  clinicId    String
  clinic      Clinic            @relation(fields: [clinicId], references: [id])
  currentRoomId String?
  currentRoom  Room?            @relation(fields: [currentRoomId], references: [id])
  patientName String
  patientPhone String
  purpose     String
  cardNumber  String?
  lineUserId  String?
  queueNumber Int?
  queueOrder  Int?
  callNotifiedAt DateTime?
  waitStatus  String            @default("waiting")
  arrivalStatus String          @default("not_arrived")
  slotStart   DateTime
  status      String            @default("booked")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  intakeAnswer IntakeAnswer?
  messageLogs  MessageLog[]
  reservationLogs ReservationLog[]
}

model Room {
  id         String        @id @default(cuid())
  clinicId   String
  clinic     Clinic        @relation(fields: [clinicId], references: [id])
  name       String
  doctorName String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  reservations Reservation[]
}

model IntakeAnswer {
  id            String      @id @default(cuid())
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  answers       String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model MessageLog {
  id            String      @id @default(cuid())
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  type          String
  channel       String
  payload       String
  sentAt        DateTime    @default(now())
  createdAt     DateTime    @default(now())
}

model ReservationLog {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  type          String
  payload       String
  createdAt     DateTime    @default(now())
}
